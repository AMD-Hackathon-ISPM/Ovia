# Public gateway port. Only this port is published by the default stack.
OVIA_HTTP_PORT=80

# A model that does not answer within this window is marked inference_error;
# the other independent screenings still complete.
MODEL_WORKER_TIMEOUT_SECONDS=45

# Optional narrative orchestration. Model evidence remains independently visible.
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
