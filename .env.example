# Loopback-only Ovia gateway port. The existing HTTPS Nginx proxies /ovia here.
OVIA_HTTP_PORT=8088

# A model that does not answer within this window is marked inference_error;
# the other independent screenings still complete.
MODEL_WORKER_TIMEOUT_SECONDS=45

# Optional narrative orchestration is configured in BE/.env. Copy
# BE/.env.example to BE/.env and keep LLM_PROVIDER=disabled unless configured.
