# Copy to .env.local (git-ignored) and adjust. Real values never belong in this
# file, and no secret belongs in any VITE_ variable: they are compiled into the
# public bundle and are readable by anyone who loads the page.

# "fixture" (default) runs offline against canned outcomes.
# "live" talks to the Rust backend.
VITE_OVIA_ADAPTER=fixture

# Backend origin, no trailing slash. Required when VITE_OVIA_ADAPTER=live.
VITE_OVIA_API_BASE_URL=http://127.0.0.1:8080

# Per-attempt timeout in milliseconds. Optional; defaults to 60000.
# Keep it below the flow's 90s hard timeout so this fires first.
VITE_OVIA_REQUEST_TIMEOUT_MS=60000
