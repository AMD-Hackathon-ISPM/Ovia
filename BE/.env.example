# HTTP
OVIA_HOST=0.0.0.0
OVIA_PORT=8080
OVIA_MODELS_DIR=models
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_IMAGE_BYTES=15728640
MAX_IMAGE_PIXELS=24000000

# auto attempts CUDA only when the binary was compiled with --features cuda.
# cpu is the safe development/default value; cuda fails startup if unavailable.
ORT_EXECUTION_PROVIDER=cpu

# Featherless-compatible orchestration. Keep disabled for deterministic-only use.
LLM_PROVIDER=disabled
LLM_BASE_URL=https://replace-with-your-provider-base-url.example/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# Windows dynamic ONNX Runtime only. Point to a compatible 1.27+ DLL.
# ORT_DYLIB_PATH=C:\path\to\onnxruntime.dll
